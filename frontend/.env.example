# --- required ---
# Your Render backend, no trailing slash.
NEXT_PUBLIC_API_URL=https://chexnet-api-xxxx.onrender.com

# --- recommended: shown in the header and footer ---
NEXT_PUBLIC_FRONTEND_REPO=https://github.com/<you>/chexnet-frontend
NEXT_PUBLIC_BACKEND_REPO=https://github.com/<you>/chexnet-backend

# --- optional ---
# Only needed for a custom domain; on Vercel, VERCEL_URL is used automatically.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
